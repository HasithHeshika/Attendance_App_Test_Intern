# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Firebase Configuration (replace with your project credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# ─── Multi-domain / multi-database ────────────────────────────────────────────
# ONE deployment serves several domains, each with its own Firestore database in the
# SAME Firebase project (same auth pool, same storage bucket, same functions):
#
#   altavision.lk  →  (default)
#   carecode.org   →  southernlanka
#
# The map lives in the `tenants` Firestore database (edited at /platform), NOT in the code,
# and is resolved from the request hostname — the env vars below CANNOT decide it, because
# one build serves every domain. They are only the fallback for localhost and preview
# deploys, where the host matches no tenant.
# NEXT_PUBLIC_FIRESTORE_DB_ID=southernlanka   # client SDK (browser)
# FIRESTORE_DB_ID=southernlanka               # admin SDK (server / API routes)
#
# Adding a domain: create the Firestore database, add a matching entry to firebase.json,
# deploy rules AND indexes to it, add the domain under Firebase Auth → Settings → Authorized
# domains, add the db id to TENANT_DB_IDS in functions/.env — THEN register the domain at
# /platform. `npm run tenants:list` shows what the registry currently holds.

# Firestore offline cache mode: multi (default) | single | memory.
# Both domains get the persistent IndexedDB cache. Only set this if the firebase-js-sdk
# "INTERNAL ASSERTION FAILED: Unexpected state" bug resurfaces — see src/lib/firebase.ts.
# NEXT_PUBLIC_FIRESTORE_CACHE=multi

# Google OAuth (optional - configure in your Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Gemini API key — server-only, powers AI bill reading for suspense expense submissions
# (src/lib/geminiBillReader.ts). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key
# The model is chosen per bill, and by default nothing here needs setting:
#   handwritten (or unmarked) → gemini-flash-latest       — the stronger multimodal flash model,
#                                                           because a misread handwritten digit
#                                                           becomes a wrong reimbursement
#   printed                   → gemini-flash-lite-latest  — the cheap, fast model, for the easy
#                                                           high-volume majority of bills
# Both are Google's always-current aliases, so a retired dated model can't silently break bill
# reading. They resolve today to the gemini-3.7-flash and gemini-3.5-flash-lite generation.
# Optional overrides — set only if you need to pin or re-route:
# GEMINI_BILL_MODEL=gemini-3.7-flash            # forces ONE model for EVERY call, ignoring the routing
# GEMINI_BILL_MODEL_HANDWRITTEN=gemini-3.7-flash
# GEMINI_BILL_MODEL_PRINTED=gemini-3.5-flash-lite

# ─── AI spend cap (src/lib/aiUsageBudget.ts) ──────────────────────────────────
# The HARD cap is the monthly limit on the Google billing account (Cloud console → Billing →
# Auto-reload → "Monthly limit"), currently $50. The vars below are the in-app guard that stops
# calls and warns the System Admins BEFORE that hard cap is reached, so bill reading degrades to
# on-device OCR with warning instead of the key dying mid-month. Spend is counted per UTC month
# in the `ai_usage` collection of the DEFAULT database — GOOGLE_API_KEY is shared by every
# tenant, so there is one budget, not one per tenant.
# Keep AI_MONTHLY_LIMIT_USD at or below the console limit.
AI_MONTHLY_LIMIT_USD=50
# Percent of the limit at which the System Admins are notified (once), then again at 100%.
AI_WARN_PCT=80
# USD per MILLION tokens, used to convert token counts into spend. SET THESE from the current
# published rate — https://ai.google.dev/pricing. One rate pair covers both routed models, so
# quote the DEARER of the two (the handwritten one): printed bills then bill high in the guard's
# arithmetic, which trips it early rather than late.
# Leaving them unset falls back to a deliberately HIGH placeholder (0.50 / 4.00) so the guard
# trips early rather than late; that placeholder is not a real Google price and the spend figure
# it produces is not the real bill.
AI_PRICE_INPUT_PER_MTOK=0.50
AI_PRICE_OUTPUT_PER_MTOK=4.00

# Shared secret for the server-to-server working-status feed (/api/working-status).
# The planning app must send this as `Authorization: Bearer <key>`, `x-api-key`, or `?key=`.
WORKFORCE_API_KEY=change_me_to_a_long_random_secret

# Shared secret for the HF-X05 fingerprint-terminal APIs (/api/fingerprint/*). Every terminal
# sends this as `Authorization: Bearer <key>` or `x-api-key` (same convention as
# WORKFORCE_API_KEY above). A device must ALSO be registered + active in the
# attendance_devices collection (provisioned via /api/admin/fingerprint-devices) — this key
# alone is not enough. See FINGERPRINT_ATTENDANCE_API.md.
FINGERPRINT_API_KEY=change_me_to_a_long_random_secret

# Solar App SSO (/api/solar-sso): HS256 secret shared with the Solar app, server-side only.
ATTENDANCE_JWT_SECRET=change_me_shared_with_solar
SOLAR_APP_URL=https://solar.altavision.lk

# Solar (solar.altavision.lk) external REST API key — server-side only.
EXTERNAL_API_KEY=change_me_solar_api_key

# ── LogPup task bridge (Alta Vision only) — see LOGPUP_TASKS_INTEGRATION.md ──────────────
# Three DISTINCT secrets, one per job. Sharing one would mean a single compromised integration
# hands over the task API, the sign-in handoff and the notification channel at once. None of
# them is EXTERNAL_API_KEY or ATTENDANCE_JWT_SECRET above, which belong to Solar.
#
# Base URL of the LogPup deployment.
LOGPUP_APP_URL=https://logpup.altavision.lk
# Read/write LogPup tasks (/api/external/*). Sent as x-api-key, server-side only. Unset means
# the tasks section stays empty rather than erroring.
LOGPUP_API_KEY=
# HS256 secret for the sign-in handoff in BOTH directions (/api/logpup-sso mints,
# /api/auth/logpup-sso redeems). Unset disables both.
LOGPUP_SSO_SECRET=
# HMAC-SHA256 secret LogPup signs task events with (/api/logpup/events). Unset means every
# inbound webhook is refused, so assignment notifications simply never arrive.
LOGPUP_WEBHOOK_SECRET=

# Firebase Admin (server-side) — required to verify the user before minting the Solar SSO
# token. Without these, Solar opens without auto-login.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Shared secret that guards every /api/cron/* route (auto-checkout sweep, schedule pattern
# extend, daily greetings). The Netlify Scheduled Functions in netlify/functions/ send it as
# `Authorization: Bearer <CRON_SECRET>`. Set it in the Netlify site environment; routes fail
# closed (401) while it is unset.
CRON_SECRET=change_me_long_random_string
