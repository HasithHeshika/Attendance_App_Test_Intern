# Copy to functions/.env and set to match the app's Firestore database.
# Empty or "(default)" = the default database. If the app reads/writes a NAMED
# database (the app's NEXT_PUBLIC_FIRESTORE_DB_ID / FIRESTORE_DB_ID, e.g. "test"),
# set the SAME value here so the job writes where the app reads.
FIRESTORE_DB_ID=
